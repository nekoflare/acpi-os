from_source=clang
revision=1
cross_compile=yes
imagedeps="cmake ninja-build python3"

# Static glibc LLVM libraries for aac, which links the LLVM C API into a
# crt-static glibc executable (Debian ships no musl Rust std, so it cannot use
# the musl-built llvm-libs). Only the components aac uses are built.
# Installed under /opt/aac-llvm with an llvm-config that reports paths
# relative to itself; nothing here goes into the guest image.
aac_llvm_cmake() {
    cmake -S "$source_dir/llvm" -B obj -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS="$APP_CPU_FLAGS" \
        -DCMAKE_CXX_FLAGS="$APP_CPU_FLAGS" \
        -DLLVM_TARGETS_TO_BUILD=X86 \
        -DLLVM_ENABLE_PIC=OFF \
        -DLLVM_BUILD_LLVM_DYLIB=OFF \
        -DLLVM_ENABLE_ZLIB=OFF \
        -DLLVM_ENABLE_ZSTD=OFF \
        -DLLVM_ENABLE_LIBXML2=OFF \
        -DLLVM_ENABLE_LIBEDIT=OFF \
        -DLLVM_ENABLE_LIBPFM=OFF \
        -DLLVM_ENABLE_TERMINFO=OFF \
        -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF \
        -DLLVM_INCLUDE_BENCHMARKS=OFF \
        -DLLVM_INCLUDE_DOCS=OFF
}

configure() { aac_llvm_cmake; }

# Keep in sync with COMPONENTS in amlaot's build.rs.
build() {
    aac_llvm_cmake
    cmake --build obj -j"$parallelism" \
        --target llvm-config LLVMCore LLVMBitReader LLVMLinker LLVMAnalysis
}

package() {
    install -Dm755 obj/bin/llvm-config "$dest_dir/opt/aac-llvm/bin/llvm-config"
    mkdir -p "$dest_dir/opt/aac-llvm/lib"
    cp obj/lib/libLLVM*.a "$dest_dir/opt/aac-llvm/lib/"
}
