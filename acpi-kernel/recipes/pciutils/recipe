version=3.15.0
revision=1
cross_compile=yes
tarball_url=https://www.kernel.org/pub/software/utils/pciutils/pciutils-3.15.0.tar.xz
tarball_sha256=c02940f430841ecf158d5d9a50007afc4d5353c8678a2455003ca0b2c4e9f5ff
builddeps=musl

configure() { copy_source; }
build() {
    musl_env
    uapi=$(uapi_dir)
    make -C src -j"$parallelism" \
        CC="$CC" OPT="$CFLAGS" CFLAGS="$CFLAGS" CPPFLAGS="$CPPFLAGS -I$uapi" LDFLAGS="$LDFLAGS" \
        SHARED=no ZLIB=no DNS=no LIBKMOD=no HWDB=no \
        PREFIX=/usr BINDIR=/usr/bin IDSDIR=/usr/share/hwdata
}
package() {
    install -Dm755 src/lspci "$dest_dir/usr/bin/lspci"
    install -Dm644 src/pci.ids "$dest_dir/usr/share/hwdata/pci.ids"
    install -Dm644 src/COPYING "$dest_dir/usr/share/licenses/pciutils/COPYING"
}
