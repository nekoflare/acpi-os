diff --color -ru a/libnsfb/src/surface/x.c b/libnsfb/src/surface/x.c
--- a/libnsfb/src/surface/x.c	2026-11-24 22:31:36.083850654 +0100
+++ b/libnsfb/src/surface/x.c	2026-11-24 22:31:36.093816422 +0100
@@ -390,7 +390,16 @@
             break;
 
         case 0xFF: /* Keyboard */
-            nsfb_key = XCSKeyboardMap[chrcode];
+            /* The table leaves F1, Control and Alt unmapped: without them
+             * NetSurf never sees Ctrl held (Ctrl+A arrives as "a"). */
+            switch (chrcode) {
+            case 0xBE: nsfb_key = NSFB_KEY_F1; break;
+            case 0xE3: nsfb_key = NSFB_KEY_LCTRL; break;
+            case 0xE4: nsfb_key = NSFB_KEY_RCTRL; break;
+            case 0xE9: nsfb_key = NSFB_KEY_LALT; break;
+            case 0xEA: nsfb_key = NSFB_KEY_RALT; break;
+            default: nsfb_key = XCSKeyboardMap[chrcode]; break;
+            }
             break;
         }
     }
