version=2.13.3
revision=1
cross_compile=yes
tarball_url="https://codeload.github.com/freetype/freetype/tar.gz/refs/tags/VER-2-13-3"
tarball_sha256=bc5c898e4756d373e0d991bab053036c5eb2aa7c0d5c67e8662ddc6da40c4103
builddeps="musl"
imagedeps="cmake ninja-build"

configure() {
    musl_env
    cmake -S "$source_dir" -B obj -G Ninja -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DFT_DISABLE_HARFBUZZ=ON -DFT_DISABLE_PNG=ON \
        -DFT_DISABLE_BROTLI=ON -DFT_DISABLE_BZIP2=ON -DFT_DISABLE_ZLIB=ON
}
build() { cmake --build obj -j"$parallelism"; }
package() { DESTDIR="$dest_dir" cmake --install obj; }
