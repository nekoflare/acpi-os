version=3.54.1
revision=1
cross_compile=yes
tarball_url=https://sqlite.org/2026/sqlite-autoconf-3540100.tar.gz
tarball_sha256=926ef8d3eab93fbf6e06011901273eec076b25594a4e1cdadd50c987f4f6d64e
builddeps=musl

# Static single-threaded CLI built straight from the amalgamation. The guest
# has no dynamic loader, so extension loading is compiled out.
build() {
    musl_env
    "$CC" $CFLAGS $LDFLAGS -I"$source_dir" \
        -DSQLITE_THREADSAFE=0 -DSQLITE_OMIT_LOAD_EXTENSION -DHAVE_USLEEP=1 \
        -DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_RTREE -DSQLITE_ENABLE_MATH_FUNCTIONS \
        -DSQLITE_ENABLE_DBSTAT_VTAB -DSQLITE_ENABLE_EXPLAIN_COMMENTS \
        "$source_dir/shell.c" "$source_dir/sqlite3.c" -o sqlite3
}
package() { package_app sqlite3; }
