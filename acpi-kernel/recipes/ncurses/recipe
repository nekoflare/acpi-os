version=6.5
revision=1
cross_compile=yes
tarball_url=https://ftp.gnu.org/gnu/ncurses/ncurses-6.5.tar.gz
tarball_sha256=136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6
builddeps=musl
imagedeps=ncurses-bin

configure() {
    copy_source
    musl_env
    cd src
    ./configure --prefix=/usr --libdir=/usr/lib --mandir=/usr/share/man \
        --disable-shared --enable-static --enable-widec \
        --with-build-cc=gcc --without-ada --without-cxx \
        --without-debug --without-manpages --without-progs \
        --with-default-terminfo-dir=/usr/share/terminfo \
        --with-terminfo-dirs=/usr/share/terminfo
}

build() { make -C src -j"$parallelism"; }

package() {
    make -C src DESTDIR=/build_dir/pkgs/ncurses install.libs install.includes
    mkdir -p /build_dir/pkgs/ncurses/usr/share/terminfo
    tic -x -o /build_dir/pkgs/ncurses/usr/share/terminfo "$recipe_dir/st-256color.terminfo"
}
