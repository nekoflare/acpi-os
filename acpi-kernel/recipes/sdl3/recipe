version=3.4.20
revision=1
cross_compile=yes
tarball_url=https://github.com/libsdl-org/SDL/releases/download/release-3.4.20/SDL3-3.4.20.tar.gz
tarball_sha256=f3bb06f55bed9557227a700af2ea62e49497ebdf58037732a731a5fb3ef8581f
builddeps="musl libx11 libxext xcursor libxi libxfixes libxrender"
imagedeps="cmake ninja-build"

# Static SDL3 with only the X11 video backend linked in (no dlopen), for
# Lite XL's software framebuffer path. Audio, GL, Vulkan, D-Bus and device
# input stacks are left out.
configure() {
    musl_env
    cmake -S "$source_dir" -B obj -G Ninja -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_FIND_ROOT_PATH="$sysroot" \
        -DSDL_SHARED=OFF -DSDL_STATIC=ON -DSDL_TEST_LIBRARY=OFF \
        -DSDL_TESTS=OFF -DSDL_EXAMPLES=OFF -DSDL_INSTALL_DOCS=OFF \
        -DSDL_DEPS_SHARED=OFF -DSDL_X11=ON -DSDL_X11_SHARED=OFF \
        -DSDL_X11_XRANDR=OFF -DSDL_X11_XSCRNSAVER=OFF -DSDL_X11_XDBE=OFF \
        -DSDL_X11_XSYNC=OFF -DSDL_X11_XTEST=OFF \
        -DSDL_WAYLAND=OFF -DSDL_KMSDRM=OFF -DSDL_OFFSCREEN=OFF \
        -DSDL_OPENGL=OFF -DSDL_OPENGLES=OFF -DSDL_VULKAN=OFF \
        -DSDL_RENDER_GPU=OFF -DSDL_RENDER_VULKAN=OFF -DSDL_GPU=OFF \
        -DSDL_AUDIO=OFF -DSDL_CAMERA=OFF -DSDL_JOYSTICK=OFF -DSDL_HAPTIC=OFF \
        -DSDL_HIDAPI=OFF -DSDL_SENSOR=OFF -DSDL_POWER=OFF \
        -DSDL_DBUS=OFF -DSDL_IBUS=OFF -DSDL_LIBUDEV=OFF -DSDL_LIBURING=OFF \
        -DSDL_FRIBIDI=OFF -DSDL_LIBTHAI=OFF -DSDL_SYSTEM_ICONV=OFF \
        -DSDL_LIBICONV=OFF -DSDL_RPATH=OFF
}
build() { cmake --build obj -j"$parallelism"; }
package() { DESTDIR="$dest_dir" cmake --install obj; }
