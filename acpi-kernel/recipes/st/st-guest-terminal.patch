+/*
+ * The guest terminal reads the slave settings before editing or echoing input.
+ */
+void
+ttywriteraw(const char *s, size_t n)
+{
+	static char line[1024];
+	static size_t length;
+	struct termios settings;
+
+	if (tcgetattr(cmdfd, &settings) < 0)
+		die("Cannot read terminal settings: %s\n", strerror(errno));
+	if (!(settings.c_lflag & ICANON)) {
+		length = 0;
+		if (settings.c_lflag & ECHO)
+			twrite(s, n, 1);
+		ttywritestream(s, n);
+		return;
+	}
+
+	for (size_t i = 0; i < n; ++i) {
+		unsigned char ch = s[i];
+		if (ch == '\033' && i + 1 < n &&
+		    (s[i + 1] == '[' || s[i + 1] == 'O')) {
+			/* This line editor has no cursor motion or history. */
+			++i;
+			while (i + 1 < n) {
+				unsigned char code = s[++i];
+				if (code >= 0x40 && code <= 0x7e)
+					break;
+			}
+			continue;
+		}
+		if (ch == '\b' || ch == 127) {
+			if (length) {
+				do {
+					--length;
+				} while (length && ((unsigned char)line[length] & 0xc0) == 0x80);
+				if (settings.c_lflag & ECHO)
+					twrite("\b \b", 3, 0);
+			}
+			continue;
+		}
+		if (ch == '\r' || ch == '\n') {
+			if (ch == '\r' && i + 1 < n && s[i + 1] == '\n')
+				++i;
+			line[length++] = '\n';
+			if (settings.c_lflag & ECHO)
+				twrite("\r\n", 2, 0);
+			ttywritestream(line, length);
+			length = 0;
+			continue;
+		}
+		if ((ch >= ' ' || ch == '\t') && length < sizeof(line) - 1) {
+			line[length++] = ch;
+			/* Echo complete UTF-8 sequences together. */
+			size_t first = length - 1;
+			while (first && ((unsigned char)line[first] & 0xc0) == 0x80)
+				--first;
+			if ((settings.c_lflag & ECHO) && utf8decode(line + first, &(Rune){0}, length - first))
+				twrite(line + first, length - first, 0);
+		}
+	}
+}
