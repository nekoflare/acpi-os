 void
 resize(XEvent *e)
 {
+	XEvent next;
+
+	/* Let input and expose events keep their place in the queue. */
+	while (XEventsQueued(xw.dpy, QueuedAlready)) {
+		XPeekEvent(xw.dpy, &next);
+		if (next.type != ConfigureNotify || next.xconfigure.window != xw.win)
+			break;
+		XNextEvent(xw.dpy, e);
