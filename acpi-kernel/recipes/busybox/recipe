version=1.37.0
tarball_url=https://busybox.net/downloads/busybox-1.37.0.tar.bz2
tarball_sha256=3311dff32e746499f4df0d5df04d7eb396382d7e108bb9250e7b519b837043a4
builddeps="musl"
imagedeps="bzip2 linux-libc-dev"
revision=2
cross_compile=yes

# Package as usr/bin/busybox. The Xorg image maps it to /bin/busybox.
configure() {
    copy_source
    cd src
    make defconfig

    # Packaging choices only: one static, installable binary. No applets
    # are removed for kernel syscall gaps.
    sed -i -E 's/^# (CONFIG_(STATIC|LONG_OPTS|SHOW_USAGE|FEATURE_VERBOSE_USAGE|FEATURE_INSTALLER|USE_BB_CRYPT|USE_BB_CRYPT_SHA)) is not set$/\1=y/' .config
    sed -i -E 's/^CONFIG_(PIE|BUILD_LIBBUSYBOX|FEATURE_INDIVIDUAL|FEATURE_SHARED_BUSYBOX)=y$/# CONFIG_\1 is not set/' .config

    # tc (networking/tc.c) uses CBQ structs (tc_cbq_lssopt etc.) that were
    # removed from Linux UAPI headers in kernel 6.x. Disable it.
    sed -i -E 's/^(CONFIG_TC=y)$/# CONFIG_TC is not set/' .config

    yes '' | make oldconfig
}

build() {
    musl_env
    local uapi
    uapi=$(uapi_dir)
    ln -sfn /usr/include/mtd "$uapi/mtd"
    make -C src -j"$parallelism" \
        CC="$sysroot/opt/acpi-musl/bin/musl-gcc" \
        EXTRA_CFLAGS="$CFLAGS -idirafter $uapi" \
        LDFLAGS="$LDFLAGS"
}

package() { package_app src/busybox busybox; }
