version=32
tarball_url=https://github.com/nsxiv/nsxiv/archive/refs/tags/v32.tar.gz
tarball_sha256=37a1740db00363c3dd083bcbcd35f467c807960aa47d5811bbd1f652af19b203
builddeps="musl libx11 imlib2"
revision=3
cross_compile=yes

build() {
    copy_source
    patch -d src -p1 < "$recipe_dir/monotonic-timeouts.patch"
    patch -d src -p1 < "$recipe_dir/map-animation-once.patch"
    musl_env
    sed -i 's/^OPT_DEP_DEFAULT = 1$/OPT_DEP_DEFAULT = 0/' src/config.mk
    make -C src -j"$parallelism" CC="$CC" CFLAGS="$CFLAGS $CPPFLAGS" \
        LDFLAGS="$LDFLAGS" LDLIBS="$(pkg-config --static --libs imlib2 x11 xext freetype2) -lgif -lm"
}
package() { package_app src/nsxiv nsxiv; }
