+/* Imlib2 would otherwise map and unmap the entire file for each frame. */
+static void *map_animation(const char *path, size_t *size)
+{
+	struct stat st;
+	void *data = MAP_FAILED;
+	int fd = open(path, O_RDONLY);
+
+	if (fd < 0)
+		return MAP_FAILED;
+	if (fstat(fd, &st) == 0 && st.st_size > 0 && (uintmax_t)st.st_size <= SIZE_MAX) {
+		*size = (size_t)st.st_size;
+		data = mmap(NULL, *size, PROT_READ, MAP_PRIVATE, fd, 0);
+	}
+	close(fd);
+	return data;
+}
