version=5.2.2
revision=1
cross_compile=yes
tarball_url=https://deb.debian.org/debian/pool/main/g/giflib/giflib_5.2.2.orig.tar.gz
tarball_sha256=be7ffbd057cadebe2aa144542fd90c6838c6a083b5e8a9048b8ee3b66b29d5fb
builddeps=musl
build() {
    copy_source
    musl_env
    make -C src -j"$parallelism" CC="$CC" CFLAGS="$CFLAGS" libgif.a
}
package() {
    install -Dm644 src/libgif.a "$dest_dir/usr/lib/libgif.a"
    install -Dm644 src/gif_lib.h "$dest_dir/usr/include/gif_lib.h"
}
