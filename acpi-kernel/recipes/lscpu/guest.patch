@@ -21,10 +21,7 @@
 
 #include "lscpu.h"
 
-#if (defined(__x86_64__) || defined(__i386__))
-# define INCLUDE_VMWARE_BDOOR
-#endif
-
+/* The legacy I/O probe needs SA_SIGINFO. Keep CPUID detection enabled. */
 #ifdef INCLUDE_VMWARE_BDOOR
 # include <stdint.h>
 # include <strings.h>
--- a/include/closestream.h
+++ b/include/closestream.h
@@ -57,7 +57,13 @@
 	 * around this issue by calling close on a dup'd file
 	 * descriptor from the stream.
 	 */
-	if ((fd = fileno(stream)) < 0 || (fd = dup(fd)) < 0 || close(fd) != 0)
+	if ((fd = fileno(stream)) < 0)
+		goto error;
+	fd = dup(fd);
+	/* The guest boot console has implicit descriptors. */
+	if (fd < 0 && errno == ENOSYS)
+		return 0;
+	if (fd < 0 || close(fd) != 0)
 		goto error;
 
 	return 0;
