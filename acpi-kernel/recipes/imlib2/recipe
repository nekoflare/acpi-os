version=1.12.6
revision=4
cross_compile=yes
tarball_url="https://downloads.sourceforge.net/project/enlightenment/imlib2-src/1.12.6/imlib2-1.12.6.tar.xz"
tarball_sha256=250f9752f69dc522e529a81aaa9395705f7fc312ff2453e5de59ac2ba1f2858f
builddeps=musl
deps="freetype libx11 libxext giflib libpng libjpeg-turbo zlib"

configure() {
    static_configure --disable-progs --disable-doc-build \
        --x-includes="$sysroot/usr/include" --x-libraries="$sysroot/usr/lib" --without-x-shm-fd \
        --with-jpeg --with-png --with-zlib --without-tiff --without-webp \
        --without-id3 --without-heif
}
build() {
    musl_env
    patch -d src -p1 < "$recipe_dir/static-loaders.patch"
    patch -d src -p1 < "$recipe_dir/private-image-mapping.patch"
    static_build
    # A static library cannot dlopen its loader modules: link the ones the
    # patch registers (and their helpers) into libImlib2.a.
    loaders=src/src/modules/loaders
    for name in gif jpeg png zlib; do
        "$CC" $CFLAGS $CPPFLAGS -I src -I src/src/lib -Dloader=builtin_loader_$name \
            -c "$loaders/loader_$name.c" -o loader-$name.o
    done
    for helper in exif ldrs_util decompress_load; do
        "$CC" $CFLAGS $CPPFLAGS -I src -I src/src/lib -c "$loaders/$helper.c" -o $helper.o
    done
    ar r src/src/lib/.libs/libImlib2.a loader-*.o exif.o ldrs_util.o decompress_load.o
}
package() { autoconf_package; }
