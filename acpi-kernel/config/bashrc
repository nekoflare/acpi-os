# This bash build lacks PROMPT_STRING_DECODE, so \w in PS1 stays literal.
# PROMPT_COMMAND runs before every prompt and can assign an expanded path.
PROMPT_COMMAND='PS1="root@localhost:$PWD# "'
# musl has a built-in C.UTF-8 locale; without LANG, setlocale(LC_ALL, "")
# returns a mixed "C.UTF-8;C;..." name that btop rejects as non-UTF-8.
export LANG=C.UTF-8
